---
import Base from '../layouts/Base.astro';
import Alta from '../components/Alta.astro';
import { PRODUCTOS, enlace } from '../data/productos';

const title = 'BAEHR España | Cosmética profesional para pies, manos y uñas';
const description =
  'Cosmética profesional para pies, manos y uñas de la marca alemana BAEHR. Distribuidor oficial en España para salones, podólogos y particulares.';
import fichas from '../data/fichas.json';
// La vitrina: dónde está cada producto en la imagen del estudio (porcentaje del ancho y del alto)
const PUNTOS = [
  [17.4, 58],
  [33.2, 60],
  [46.1, 56],
  [68.5, 55],
  [83.2, 56],
];
const PASOS = ['Baño de pies', 'Exfoliación', 'Mascarilla', 'Crema', 'Crema en espuma'];
const nb = (s: string) => s.replace(/ (ml|pares|%)/g, '\u00a0$1');
---

<Base title={title} description={description} page="home">
      <section class="film" id="inicio" aria-label="El protocolo, paso a paso">
        <div class="film__sticky">
          <div class="hero">
            <h1>
              <span class="h1__big">Cosmética</span>
              <span class="h1__big">profesional</span>
              <span class="h1__soft">para pies, manos y uñas</span>
            </h1>
            <p class="hero__lead">
              Marca alemana fundada en 1949. BAEHR España es distribuidor oficial de la marca.{' '}
              <span data-when="pro">Date de alta y compra a precio profesional.</span>
              <span data-when="home">Envío gratis en pedidos a partir de 60&nbsp;€.</span>
            </p>
            <div class="hero__cta">
              <a class="pill pill--red" href="#profesionales" data-when="pro">Darme de alta</a>
              <a class="pill pill--line" href="#inicio" data-go-step="0" data-play data-when="pro">Ver el protocolo</a>
              <a class="pill pill--red" href="#inicio" data-go-step="0" data-play data-when="home">Ver el protocolo</a>
              <a class="pill pill--line" href="/profesionales/" data-when="home">Soy profesional</a>
            </div>
          </div>

          <figure class="still">
            <img src="/posters/conjunto.webp" width="1000" height="1120" alt="Los cinco productos BAEHR del protocolo: frasco de baño de pies, tarro de exfoliante, caja de mascarillas, tubo de crema y bote de crema en espuma." loading="lazy" decoding="async" />
          </figure>

          <div class="stagebg" aria-hidden="true"></div>
          <img class="stage-poster" src="/posters/conjunto.webp" width="1000" height="1120" alt="" fetchpriority="high" decoding="async" aria-hidden="true" />
          <canvas id="stage" aria-hidden="true"></canvas>
          <div class="vig" aria-hidden="true"></div>
          <div class="grain" aria-hidden="true"></div>

          <article class="chap chap--left">
            <h2 class="chap__h">Baño de&nbsp;pies</h2>
            <p class="chap__prod">SPA Wellness Fußbad, 500&nbsp;ml</p>
            <p class="chap__text">Limpia con suavidad y refresca los pies cansados.</p>
            <ul class="facts">
              <li>Con hibisco y loto</li>
              <li>Vegano</li>
              <li>De 5 a 10&nbsp;ml por baño</li>
            </ul>
            <a class="pill pill--white" href="/tienda/?tipo=bano">Ver el baño de pies</a>
            <img class="still__img" src="/posters/paso-1.webp" width="1400" height="900" alt="Frasco blanco de SPA Wellness Fußbad, con dosificador, junto a un cuenco blanco con agua en el que cae un chorro fino." loading="lazy" decoding="async" />
          </article>

          <article class="chap chap--right">
            <h2 class="chap__h">Exfoliación</h2>
            <p class="chap__prod">fresh feet Fußpeeling, 125&nbsp;ml</p>
            <p class="chap__text">Alisa la piel áspera de los pies.</p>
            <ul class="facts">
              <li>Con sal marina</li>
              <li>Con minerales y oligoelementos</li>
              <li>En 125 y 450&nbsp;ml</li>
            </ul>
            <a class="pill pill--white" href="/tienda/?tipo=exfoliante">Ver el exfoliante</a>
            <img class="still__img" src="/posters/paso-2.webp" width="1400" height="900" alt="Tarro abierto del exfoliante fresh feet Fußpeeling, con la tapa al lado y cristales de sal alrededor." loading="lazy" decoding="async" />
          </article>

          <article class="chap chap--left">
            <h2 class="chap__h">Mascarilla</h2>
            <p class="chap__prod">Fuß-Vliesmaske Orange-Lemongras</p>
            <p class="chap__text">Mascarilla de tejido para el cuidado intensivo de la piel muy seca de los pies.</p>
            <ul class="facts">
              <li>Con karité, macadamia y coco</li>
              <li>Vegana</li>
              <li>Caja de 5 pares</li>
            </ul>
            <a class="pill pill--white" href="/tienda/?tipo=mascarilla">Ver la mascarilla</a>
            <img class="still__img" src="/posters/paso-3.webp" width="1400" height="900" alt="Caja de la mascarilla Fuß-Vliesmaske Orange-Lemongras, de la que salen cinco sobres en abanico." loading="lazy" decoding="async" />
          </article>

          <article class="chap chap--right">
            <h2 class="chap__h">Crema</h2>
            <p class="chap__prod">Fußcreme Orange-Lemongras, 125&nbsp;ml</p>
            <p class="chap__text">Cuida la piel de los pies con aceites de naranja y de lemongrass.</p>
            <ul class="facts">
              <li>Con urea</li>
              <li>Vegana</li>
              <li>En 30, 125 y 500&nbsp;ml</li>
            </ul>
            <a class="pill pill--white" href="/tienda/?tipo=crema">Ver la crema</a>
            <img class="still__img" src="/posters/paso-4.webp" width="1400" height="900" alt="Tubo de la crema Fußcreme Orange-Lemongras, inclinado en el aire, con una espiral de crema debajo." loading="lazy" decoding="async" />
          </article>

          <article class="chap chap--left">
            <h2 class="chap__h">Crema en&nbsp;espuma</h2>
            <p class="chap__prod">Cremeschaum Orange-Lemongras, 125&nbsp;ml</p>
            <p class="chap__text">Espuma de textura ligera y rápida absorción.</p>
            <ul class="facts">
              <li>Con un 5&nbsp;% de urea</li>
              <li>Vegana</li>
              <li>En 125 y 300&nbsp;ml</li>
            </ul>
            <a class="pill pill--white" href="/productos/crema-en-espuma-orange-lemongras/">Ver la crema en espuma</a>
            <img class="still__img" src="/posters/paso-5.webp" width="1400" height="900" alt="Bote de la crema en espuma Cremeschaum Orange-Lemongras, inclinado en el aire, con una nube de espuma debajo." loading="lazy" decoding="async" />
          </article>

          <div class="fin">
            <h2 class="fin__h">Cinco pasos, un&nbsp;protocolo</h2>
            <p class="fin__text">Un producto BAEHR para cada paso.</p>
            <div class="fin__cta">
              <a class="pill pill--white" href="/profesionales/#pedido-rapido" data-when="pro">Pedir los cinco productos</a>
              <a class="pill pill--white" href="/tienda/" data-when="home">Comprar los cinco productos</a>
            </div>
          </div>

          <nav class="stepper" aria-label="Pasos del protocolo">
            <button type="button">Baño</button>
            <button type="button">Exfoliación</button>
            <button type="button">Mascarilla</button>
            <button type="button">Crema</button>
            <button type="button">Espuma</button>
          </nav>
          <button class="film__add" type="button" data-film-add data-done="Añadido" aria-label="Añadir a la cesta">Añadir<span class="add__more"> a la cesta</span></button>
          <a class="film__skip" href="#tienda" aria-label="Saltar la animación">Saltar<span class="skip__more"> la animación</span></a>
          <div class="flash" aria-hidden="true"></div>
          <p class="cue" aria-hidden="true">Desliza</p>
        </div>
      </section>

      <section class="vitrina" id="tienda" aria-labelledby="tienda-h">
        <div class="vitrina__head">
          <h2 class="h2 rv" id="tienda-h">Los cinco, de un&nbsp;vistazo</h2>
          <div class="shop__side">
            <p class="lead rv">Por orden de uso, del baño de pies a la crema en espuma.</p>
            <a class="pill pill--red rv" href="/profesionales/#pedido-rapido" data-when="pro">Pedir los cinco productos</a>
            <a class="pill pill--red rv" href="/tienda/" data-when="home">Comprar los cinco productos</a>
          </div>
        </div>
        <div class="vitrina__stage rv" data-vitrina>
          <div class="vitrina__scene">
            <img src="/img/estudio/baehr.webp" width="1800" height="760" alt="" loading="lazy" decoding="async" />
            {
              fichas.productos.map((f, k) => (
                <button
                  class="vitrina__dot"
                  type="button"
                  style={`--x:${PUNTOS[k][0]}%;--y:${PUNTOS[k][1]}%`}
                  aria-pressed={k === 0 ? 'true' : 'false'}
                  aria-label={`${PASOS[k]}: ${f.nombre}`}
                />
              ))
            }
          </div>
        </div>
        <div class="vitrina__band">
          {
            fichas.productos.map((f, k) => (
              <div class="vitrina__item" hidden={k !== 0}>
                <div class="vitrina__what">
                  <p class="vitrina__paso">{PASOS[k]}</p>
                  <p class="vitrina__name" lang="de">{f.nombre}</p>
                  <p class="vitrina__tipo" set:html={nb(`${f.h1}, ${f.tamanos.map((t) => t.charAt(0).toLowerCase() + t.slice(1)).join(', ')}`)} />
                </div>
                <div class="vitrina__go">
                  <button class="pill pill--red" type="button" data-add={f.id} data-done="Añadido">Añadir a la cesta</button>
                  <a class="pill pill--line" href={`/productos/${f.slug}/`}>Ver la ficha</a>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="shop shop--bloque" aria-label="Los cinco productos">
        <ul class="shop__row">
          <li class="card rv">
            <a class="card__link" href="/productos/bano-de-pies-spa-wellness/">
              <span class="card__img card__img--studio" style="view-transition-name: prod-bano"><img src="/img/estudio/bano.webp" width="800" height="1200" alt="" loading="lazy" decoding="async" /></span>
              <span class="card__name" lang="de">SPA Wellness Fußbad</span>
              <span class="card__type">Baño de pies</span>
              <span class="card__type">500&nbsp;ml</span>
              <span class="card__go">Ver la ficha</span>
            </a>
          </li>
          <li class="card rv">
            <a class="card__link" href="/productos/exfoliante-para-pies-fresh-feet/">
              <span class="card__img card__img--studio" style="view-transition-name: prod-exfoliante"><img src="/img/estudio/exfoliante.webp" width="800" height="1200" alt="" loading="lazy" decoding="async" /></span>
              <span class="card__name" lang="de">fresh feet Fußpeeling</span>
              <span class="card__type">Exfoliante para pies</span>
              <span class="card__type">125 y 450&nbsp;ml</span>
              <span class="card__go">Ver la ficha</span>
            </a>
          </li>
          <li class="card rv">
            <a class="card__link" href="/productos/mascarilla-para-pies-orange-lemongras/">
              <span class="card__img card__img--studio" style="view-transition-name: prod-mascarilla"><img src="/img/estudio/mascarilla.webp" width="800" height="1200" alt="" loading="lazy" decoding="async" /></span>
              <span class="card__name" lang="de">Fuß-Vliesmaske Orange-Lemongras</span>
              <span class="card__type">Mascarilla para pies</span>
              <span class="card__type">Caja de 5&nbsp;pares</span>
              <span class="card__go">Ver la ficha</span>
            </a>
          </li>
          <li class="card rv">
            <a class="card__link" href="/productos/crema-para-pies-orange-lemongras/">
              <span class="card__img card__img--studio" style="view-transition-name: prod-crema"><img src="/img/estudio/crema.webp" width="800" height="1200" alt="" loading="lazy" decoding="async" /></span>
              <span class="card__name" lang="de">Fußcreme Orange-Lemongras</span>
              <span class="card__type">Crema para pies</span>
              <span class="card__type">30, 125 y 500&nbsp;ml</span>
              <span class="card__go">Ver la ficha</span>
            </a>
          </li>
          <li class="card card--main rv">
            <a class="card__link" href="/productos/crema-en-espuma-orange-lemongras/" aria-label="Ver la ficha de la crema en espuma">
              <span class="card__img card__img--studio" style="view-transition-name: prod-espuma"><img src="/img/estudio/espuma.webp" width="800" height="1200" alt="" loading="lazy" decoding="async" /></span>
              <span class="card__name" lang="de">Cremeschaum Orange-Lemongras</span>
              <span class="card__type">Crema en espuma</span>
              <span class="card__type">125 y 300&nbsp;ml</span>
              <span class="card__go">Ver la ficha</span>
            </a>
          </li>
        </ul>
      </section>

      <section class="dark" id="profesionales">
        <div class="dark__text" data-when="pro">
          <h2 class="h2 rv">Solicita tu alta profesional en dos&nbsp;minutos</h2>
          <p class="lead rv">
            Rellena los datos de tu negocio. Revisamos la solicitud y activamos tus precios
            profesionales.
          </p>
          <ul class="ticks rv">
            <li>Precios profesionales</li>
            <li>Pedido rápido por referencia</li>
            <li>Repite tu último pedido con un clic</li>
            <li>Facturas e historial de pedidos en tu cuenta</li>
          </ul>
          <a class="textlink textlink--light rv" href="/mi-cuenta/">Ver una cuenta de ejemplo</a>
        </div>
        <Alta />

        <div class="dark__text dark__text--wide" data-when="home">
          <h2 class="h2 rv">Lo que usan los profesionales, también en&nbsp;casa</h2>
          <p class="lead rv">
            Compra los mismos productos para el cuidado de tus pies. Envío gratis en pedidos a partir de 60&nbsp;€.
          </p>
          <a class="pill pill--red rv" href="#inicio" data-go-step="0" data-play>Ver el protocolo</a>
        </div>
      </section>

      <section class="seminars" id="seminarios">
        <div class="seal" aria-hidden="true"></div>
        <h2 class="h2 rv">Seminarios para&nbsp;profesionales</h2>
        <article class="seminar rv">
          <p class="seminar__date"><b>26</b> nov</p>
          <div class="seminar__body">
            <h3>Beauty Expert: maratón formativo&nbsp;online</h3>
            <p>
              Onicólisis y cuidado profesional BAEHR. Online, de 10:00 a 12:00 (hora peninsular). En ruso con
              traducción al español.
            </p>
          </div>
          <a class="pill pill--red" href="#seminarios">Inscribirme</a>
        </article>
        <a class="textlink rv" href="#seminarios">Ver todos los seminarios</a>
      </section>

      <section class="brand" id="marca">
        <div class="seal" aria-hidden="true"></div>
        <h2 class="h2 rv">Una marca alemana con&nbsp;oficio</h2>
        <picture class="brand__pic rv" style="view-transition-name: marca-film">
          {/* en pantallas anchas la vitrina ya muestra la palabra de frente: aquí se ve en perspectiva */}
          <source media="(min-width: 721px)" srcset="/img/estudio/baehr-lado.webp" />
          <img class="brand__img" src="/img/estudio/baehr.webp" width="1800" height="760" alt="" loading="lazy" decoding="async" />
        </picture>
        <div class="brand__grid">
          <p class="lead rv">
            BAEHR nació en 1949 en Waiblingen, cerca de Stuttgart, y sigue siendo una empresa familiar. BAEHR
            España lleva sus productos a salones, profesionales de manicura y pedicura, podólogos y
            particulares.
          </p>
          <dl class="stats">
            <div class="stat rv">
              <dt>1949</dt>
              <dd>año de fundación</dd>
            </div>
            <div class="stat rv">
              <dt>+40</dt>
              <dd>países con distribuidor oficial</dd>
            </div>
            <div class="stat rv">
              <dt>7</dt>
              <dd>tipos de piel en el sistema PEDIBAEHR</dd>
            </div>
          </dl>
        </div>
        <a class="textlink rv" href="/la-marca/">Conocer la marca</a>
      </section>

</Base>

<script>
  import '../scripts/film.js';

  // La vitrina: al señalar un producto en la imagen, la banda de abajo muestra ese producto y la imagen se acerca a él
  const vit = document.querySelector<HTMLElement>('[data-vitrina]');
  if (vit) {
    const scene = vit.querySelector<HTMLElement>('.vitrina__scene')!;
    const dots = [...vit.querySelectorAll<HTMLElement>('.vitrina__dot')];
    const items = [...document.querySelectorAll<HTMLElement>('.vitrina__item')];
    const pick = (i: number, zoom = true) => {
      dots.forEach((d, k) => d.setAttribute('aria-pressed', String(k === i)));
      items.forEach((it, k) => (it.hidden = k !== i));
      scene.style.setProperty('--ox', dots[i].style.getPropertyValue('--x'));
      scene.style.setProperty('--oy', dots[i].style.getPropertyValue('--y'));
      vit.classList.toggle('is-zoom', zoom);
    };
    dots.forEach((d, i) => {
      d.addEventListener('click', () => pick(i));
      d.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && pick(i));
      d.addEventListener('focus', () => pick(i));
    });
    vit.addEventListener('pointerleave', () => vit.classList.remove('is-zoom'));
  }
  // Añadir a la cesta desde la vitrina: demostración, no envía nada
  document.querySelectorAll<HTMLButtonElement>('.vitrina [data-add]').forEach((b) => {
    const label = b.textContent;
    let back = 0;
    b.addEventListener('click', () => {
      (window as any).baehrCesta?.add(b.dataset.add, 1);
      b.textContent = b.dataset.done || label;
      clearTimeout(back);
      back = window.setTimeout(() => (b.textContent = label), 1500);
    });
  });
</script>
