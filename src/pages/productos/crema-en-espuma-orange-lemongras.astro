---
// Ficha de producto de ejemplo: Cremeschaum Orange-Lemongras (PEDIBAEHR, línea WELLNESS).
// Feiten: docs/merk-en-woordenlijst.md, deel A. Geen prijs: die staat niet in de bron.
import Base from '../../layouts/Base.astro';

const title = 'Crema en espuma para pies Orange-Lemongras | BAEHR España';
const description =
  'Crema en espuma PEDIBAEHR con un 5 % de urea, pantenol y extractos de ginkgo, ginseng y limón. Ligera y de rápida absorción. Vegana. En 125 y 300 ml.';

const faq = [
  {
    q: '¿Cuánta urea lleva?',
    a: 'La crema en espuma Cremeschaum Orange-Lemongras lleva un 5 % de urea. Sus otros principios activos son el pantenol y los extractos de ginkgo, ginseng y limón.',
  },
  {
    q: '¿En qué se diferencia de la crema de pies Orange-Lemongras?',
    a: 'Las dos llevan urea, pero difieren en la textura y en el resto de los activos. La crema de pies Orange-Lemongras lleva aceites de naranja y de lemongrass; la crema en espuma, un 5 % de urea, pantenol y extractos de ginkgo, ginseng y limón, en una espuma ligera de rápida absorción.',
  },
  {
    q: '¿Qué indica el sello de cinco estrellas?',
    a: 'Es el sello de tolerancia cutánea de Dermatest GmbH. El de la crema en espuma Cremeschaum Orange-Lemongras es de septiembre de 2025 y se basa en una prueba clínica de 4 semanas con 20 voluntarios.',
  },
  { q: '¿Es vegana?', a: 'Sí. La crema en espuma Cremeschaum Orange-Lemongras es vegana.' },
  {
    q: '¿Quién es el fabricante?',
    a: 'Gustav Baehr GmbH, una empresa familiar con sede en Waiblingen (Alemania). En España la distribuye BAEHR España, distribuidor oficial de la marca.',
  },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://baehr.com.es/' },
      { '@type': 'ListItem', position: 2, name: 'Tienda', item: 'https://baehr.com.es/#tienda' },
      { '@type': 'ListItem', position: 3, name: 'Cremas en espuma', item: 'https://baehr.com.es/tienda/' },
      { '@type': 'ListItem', position: 4, name: 'Orange-Lemongras' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Cremeschaum Orange-Lemongras',
    description,
    image: 'https://baehr.com.es/img/productos/espuma.webp',
    brand: { '@type': 'Brand', name: 'PEDIBAEHR' },
    manufacturer: { '@type': 'Organization', name: 'Gustav Baehr GmbH' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const steps = ['Baño de pies', 'Exfoliación', 'Mascarilla', 'Crema', 'Crema en espuma'];
const pairs = [
  { img: 'bano', name: 'SPA Wellness Fußbad', type: 'Baño de pies con hibisco y loto', size: '500 ml', step: 0, aria: 'Ver el baño de pies en el protocolo' },
  { img: 'exfoliante', name: 'fresh feet Fußpeeling', type: 'Exfoliante de pies con sal marina', size: '125 y 450 ml', step: 1, aria: 'Ver el exfoliante en el protocolo' },
  { img: 'mascarilla', name: 'Fuß-Vliesmaske Orange-Lemongras', type: 'Mascarilla de tejido para pies muy secos', size: 'Caja de 5 pares', step: 2, aria: 'Ver la mascarilla en el protocolo' },
  { img: 'crema', name: 'Fußcreme Orange-Lemongras', type: 'Crema de pies con aceites de naranja y de lemongrass', size: '30, 125 y 500 ml', step: 3, aria: 'Ver la crema de pies en el protocolo' },
];
---

<Base title={title} description={description} page="producto" jsonld={jsonld}>
  <nav class="crumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <a href="/tienda/">Tienda</a>
    <a href="/tienda/">Cremas en espuma</a>
    <span aria-current="page">Orange-Lemongras</span>
  </nav>

  <section class="pdp">
    <div class="pdp__stage" data-visor tabindex="0" role="img" aria-label="Modelo 3D giratorio del bote de Cremeschaum Orange-Lemongras">
      <img class="pdp__still" src="/img/productos/espuma.webp" width="600" height="900" alt="Bote blanco de la crema en espuma Cremeschaum Orange-Lemongras, de PEDIBAEHR, con la etiqueta de frente." decoding="async" />
      <canvas class="pdp__canvas" aria-hidden="true"></canvas>
      <div class="pdp__hint" aria-hidden="true"><span class="pdp__ribs"></span>Arrastra para girar</div>
      <button class="pdp__pause" type="button" data-visor-pause data-pause="Pausar el giro" data-play="Reanudar el giro" aria-pressed="false">Pausar el giro</button>
    </div>

    <div class="pdp__buy">
      <h1 class="pdp__h">
        <span class="pdp__big">Crema en&nbsp;espuma</span>
        <span class="pdp__soft" lang="de">Cremeschaum Orange-Lemongras</span>
      </h1>
      <ul class="chips" aria-label="Marca, línea y serie">
        <li>PEDIBAEHR</li>
        <li>Línea WELLNESS</li>
        <li>Serie Orange-Lemongras</li>
      </ul>
      <p class="pdp__lead">
        Espuma ligera y de rápida absorción para el cuidado de los pies. Lleva un 5&nbsp;% de urea, pantenol y extractos de
        ginkgo, ginseng y limón. Vegana.
      </p>

      <fieldset class="sizes">
        <legend>Tamaño</legend>
        <label><input type="radio" name="tam" value="125" checked /><span>125&nbsp;ml</span></label>
        <label><input type="radio" name="tam" value="300" /><span>300&nbsp;ml</span></label>
      </fieldset>

      <div class="price" data-when="pro">
        <p class="price__label">Precio profesional</p>
        <p class="price__text">Lo verás al acceder a tu cuenta.</p>
        <p class="price__links">
          <a class="textlink" href="/profesionales/#alta">Acceder</a>
          <span>¿Aún no tienes cuenta? <a class="textlink" href="/profesionales/#alta">Solicitar el alta</a></span>
        </p>
      </div>
      <div class="price" data-when="home">
        <p class="price__label">Precio para particulares</p>
        <p class="price__text">Precio pendiente de publicar.</p>
      </div>

      <form class="addcart" novalidate>
        <div class="qty" role="group" aria-label="Cantidad">
          <button type="button" data-qty="-1" aria-label="Uno menos">−</button>
          <output aria-live="polite">1</output>
          <button type="button" data-qty="1" aria-label="Uno más">+</button>
        </div>
        <button class="pill pill--red addcart__btn" type="submit">Añadir a la cesta</button>
        <p class="addcart__ok" role="status" hidden>Añadido a la cesta. <a class="textlink" href="/tienda/" data-open-cart>Ver la cesta</a></p>
      </form>

      <ul class="service">
        <li data-when="home">Envío gratuito en pedidos a partir de 60&nbsp;€.</li>
        <li>Fabricante: Gustav Baehr GmbH, Waiblingen (Alemania).</li>
        <li>Vendido por BAEHR España, distribuidor oficial de la marca.</li>
      </ul>
    </div>
  </section>

  <div class="buybar" aria-hidden="true">
    <span class="buybar__name" lang="de">Cremeschaum Orange-Lemongras</span>
    <button class="pill pill--red" type="button" tabindex="-1" data-buybar>Añadir a la cesta</button>
  </div>

  <section class="band" aria-label="Datos del producto">
    <dl class="band__row">
      <div class="band__item rv"><dt>5&nbsp;%</dt><dd>de urea</dd></div>
      <div class="band__item rv"><dt>5 estrellas</dt><dd>en tolerancia cutánea, según Dermatest (09/2025)</dd></div>
      <div class="band__item rv"><dt>Vegana</dt><dd>sin ingredientes de origen animal</dd></div>
      <div class="band__item rv"><dt>2 tamaños</dt><dd>125 y 300&nbsp;ml</dd></div>
    </dl>
  </section>

  <section class="inside">
    <h2 class="h2 rv">Sus&nbsp;activos</h2>
    <ul class="inside__list">
      <li class="stretch"><span aria-hidden="true">Urea</span><small>Urea al 5&nbsp;%</small></li>
      <li class="stretch"><span aria-hidden="true">Pantenol</span><small class="sr">Pantenol</small></li>
      <li class="stretch"><span aria-hidden="true">Ginkgo</span><small>Extracto de ginkgo</small></li>
      <li class="stretch"><span aria-hidden="true">Ginseng</span><small>Extracto de ginseng</small></li>
      <li class="stretch"><span aria-hidden="true">Limón</span><small>Extracto de limón</small></li>
    </ul>
  </section>

  <section class="texture">
    <h2 class="h2 rv">Textura&nbsp;ligera</h2>
    <div class="texture__body">
      <p class="texture__quote rv">Una espuma de rápida absorción que deja un tacto aterciopelado.</p>
      <p class="texture__note rv">Según BAEHR, las espumas para pies se absorben más rápido que las pomadas y apenas dejan residuos.</p>
    </div>
  </section>

  <section class="proto">
    <div class="proto__text">
      <h2 class="h2 rv">El último&nbsp;paso</h2>
      <p class="lead rv">Cierra el protocolo de cinco pasos que te proponemos en la página de inicio.</p>
      <a class="pill pill--white rv" href="/#protocolo">Ver el protocolo</a>
    </div>
    <ol class="proto__steps rv" aria-label="Pasos del protocolo">
      {steps.map((s, i) => <li aria-current={i === 4 ? 'step' : undefined}>{s}</li>)}
    </ol>
  </section>

  <section class="shop shop--pairs">
    <div class="shop__head">
      <h2 class="h2 rv">Los otros cuatro&nbsp;pasos</h2>
    </div>
    <ul class="shop__row shop__row--four">
      {
        pairs.map((p) => (
          <li class="card rv">
            <a class="card__link" href={`/#paso-${p.step + 1}`} aria-label={p.aria}>
              <span class="card__img">
                <img src={`/img/productos/${p.img}.webp`} width="600" height="900" alt="" loading="lazy" decoding="async" />
              </span>
              <span class="card__name" lang="de">{p.name}</span>
              <span class="card__type">{p.type}</span>
              <span class="card__type">{p.size}</span>
              <span class="card__go">Ver en el protocolo</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="faq">
    <h2 class="h2 rv">Preguntas y&nbsp;respuestas</h2>
    <div class="faq__list">
      {
        faq.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import '../../scripts/visor.js';
  // Cantidad y cesta: demostración, no envía nada
  const form = document.querySelector('.addcart');
  const out = form?.querySelector('output');
  let n = 1;
  form?.querySelectorAll('[data-qty]').forEach((b) =>
    b.addEventListener('click', () => {
      n = Math.max(1, Math.min(99, n + Number(b.dataset.qty)));
      if (out) out.textContent = String(n);
    })
  );
  // Barra de compra en el móvil: aparece cuando el botón principal sale de la pantalla
  const bar = document.querySelector('.buybar');
  const mainBtn = form?.querySelector('.addcart__btn');
  if (bar && mainBtn && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      const below = entries[0].boundingClientRect.top < 0;
      bar.classList.toggle('is-on', !entries[0].isIntersecting && below);
    }).observe(mainBtn);
    bar.querySelector('[data-buybar]')?.addEventListener('click', () => form?.requestSubmit());
  }
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const ok = form.querySelector('.addcart__ok');
    if (ok) ok.hidden = false;
    (window as any).baehrCesta?.add('espuma', n);
  });
</script>
