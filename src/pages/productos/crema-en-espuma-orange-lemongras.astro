---
// Ficha de producto de ejemplo: Cremeschaum Orange-Lemongras (PEDIBAEHR, línea WELLNESS).
// Feiten: docs/merk-en-woordenlijst.md, deel A. Geen prijs: die staat niet in de bron.
import Base from '../../layouts/Base.astro';

const title = 'Crema en espuma para pies PEDIBAEHR Orange-Lemongras | BAEHR España';
const description =
  'Crema en espuma PEDIBAEHR con un 5 % de urea, pantenol y extractos de ginkgo, ginseng y limón. Ligera y de rápida absorción. Vegana. En 125 y 300 ml.';

const faq = [
  {
    q: '¿Cuánta urea lleva?',
    a: 'Lleva un 5 % de urea. Sus otros principios activos son el pantenol y los extractos de ginkgo, ginseng y limón.',
  },
  {
    q: '¿En qué se diferencia de la crema para pies Orange-Lemongras?',
    a: 'Las dos llevan urea, pero difieren en la textura y en el resto de los activos. La crema para pies Orange-Lemongras lleva aceites de naranja y de lemongrass; la crema en espuma, un 5 % de urea, pantenol y extractos de ginkgo, ginseng y limón, en una espuma ligera de rápida absorción.',
  },
  {
    q: '¿Qué es el sello de cinco estrellas?',
    a: 'Es el sello de tolerancia cutánea de Dermatest GmbH. El de esta crema en espuma es de septiembre de 2025 y se basa en una prueba clínica de 4 semanas con 20 voluntarios.',
  },
  { q: '¿Es vegana?', a: 'Sí, es vegana.' },
  {
    q: '¿Quién es el fabricante?',
    a: 'Gustav Baehr GmbH, una empresa familiar con sede en Waiblingen (Alemania). En España, este producto lo vende BAEHR España, distribuidor oficial de la marca.',
  },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://baehr.com.es/' },
      { '@type': 'ListItem', position: 2, name: 'Tienda', item: 'https://baehr.com.es/tienda/' },
      { '@type': 'ListItem', position: 3, name: 'Cremas en espuma', item: 'https://baehr.com.es/tienda/' },
      { '@type': 'ListItem', position: 4, name: 'Crema en espuma Orange-Lemongras' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Cremeschaum Orange-Lemongras',
    description,
    image: 'https://baehr.com.es/img/productos/espuma.webp',
    brand: { '@type': 'Brand', name: 'PEDIBAEHR' },
    manufacturer: { '@type': 'Organization', name: 'Gustav Baehr GmbH' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const steps = ['Baño de pies', 'Exfoliación', 'Mascarilla', 'Crema', 'Crema en espuma'];
const pairs = [
  { img: 'bano', name: 'SPA Wellness Fußbad', type: 'Baño de pies con hibisco y loto', size: '500 ml', step: 0, aria: 'Ver el baño de pies en el protocolo' },
  { img: 'exfoliante', name: 'fresh feet Fußpeeling', type: 'Exfoliante para pies con sal marina', size: '125 y 450 ml', step: 1, aria: 'Ver el exfoliante en el protocolo' },
  { img: 'mascarilla', name: 'Fuß-Vliesmaske Orange-Lemongras', type: 'Mascarilla de tejido para pies muy secos', size: 'Caja de 5 pares', step: 2, aria: 'Ver la mascarilla en el protocolo' },
  { img: 'crema', name: 'Fußcreme Orange-Lemongras', type: 'Crema para pies con aceites de naranja y de lemongrass', size: '30, 125 y 500 ml', step: 3, aria: 'Ver la crema para pies en el protocolo' },
];
---

<Base title={title} description={description} page="producto" jsonld={jsonld}>
  <nav class="crumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a>
    <a href="/tienda/">Tienda</a>
    <a href="/tienda/">Cremas en espuma</a>
    <span aria-current="page">Crema en espuma Orange-Lemongras</span>
  </nav>

  <section class="pdp">
    <div class="pdp__stage" data-galeria>
      <img class="pdp__img is-on" src="/img/estudio/espuma.webp" width="800" height="1200" fetchpriority="high" alt="" />
      <img class="pdp__img pdp__img--pack" src="/img/productos/espuma.webp" width="600" height="900" loading="lazy" decoding="async" alt="Bote blanco de la crema en espuma Cremeschaum Orange-Lemongras, de PEDIBAEHR, con la etiqueta de frente." />
      <img class="pdp__img" src="/img/estudio/espuma-textura.webp" width="800" height="1200" loading="lazy" decoding="async" alt="" />
      <div class="pdp__thumbs" role="group" aria-label="Imágenes del producto">
        <button type="button" aria-pressed="true" aria-label="Imagen 1 de 3"><img src="/img/estudio/espuma.webp" width="800" height="1200" alt="" /></button>
        <button type="button" aria-pressed="false" aria-label="Imagen 2 de 3"><img class="thumb--pack" src="/img/productos/espuma.webp" width="600" height="900" alt="" loading="lazy" /></button>
        <button type="button" aria-pressed="false" aria-label="Imagen 3 de 3"><img src="/img/estudio/espuma-textura.webp" width="800" height="1200" alt="" loading="lazy" /></button>
      </div>
    </div>

    <div class="pdp__buy">
      <h1 class="pdp__h">
        <span class="pdp__big">Crema en&nbsp;espuma</span>
        <span class="pdp__soft" lang="de">Cremeschaum Orange-Lemongras</span>
      </h1>
      <ul class="chips" aria-label="Marca, línea y serie">
        <li>PEDIBAEHR</li>
        <li>Línea WELLNESS</li>
        <li>Serie Orange-Lemongras</li>
      </ul>
      <p class="pdp__lead">
        Espuma ligera y de rápida absorción para el cuidado de los pies. Lleva un 5&nbsp;% de urea, pantenol y extractos de
        ginkgo, ginseng y limón. Vegana.
      </p>

      <fieldset class="sizes">
        <legend>Tamaño</legend>
        <label><input type="radio" name="tam" value="125" checked /><span>125&nbsp;ml</span></label>
        <label><input type="radio" name="tam" value="300" /><span>300&nbsp;ml</span></label>
      </fieldset>

      <div class="price" data-when="pro">
        <p class="price__label">Precio profesional</p>
        <p class="price__text">Lo verás al iniciar sesión.</p>
        <p class="price__links">
          <a class="textlink" href="/profesionales/#acceso">Iniciar sesión</a>
          <span>¿Aún no tienes cuenta? <a class="textlink" href="/profesionales/#alta">Solicita el alta</a></span>
        </p>
      </div>
      <div class="price" data-when="home">
        <p class="price__label">Precio para particulares</p>
        <p class="price__text">Precio pendiente de publicar.</p>
      </div>

      <form class="addcart" novalidate>
        <div class="qty" role="group" aria-label="Cantidad">
          <button type="button" data-qty="-1" aria-label="Reducir cantidad">−</button>
          <output aria-live="polite">1</output>
          <button type="button" data-qty="1" aria-label="Aumentar cantidad">+</button>
        </div>
        <button class="pill pill--red addcart__btn" type="submit">Añadir a la cesta</button>
        <p class="addcart__ok" role="status" hidden>Añadido a la cesta. <a class="textlink" href="/tienda/" data-open-cart>Ver la cesta</a></p>
      </form>

      <ul class="service">
        <li>5&nbsp;+&nbsp;1 gratis en productos BAEHR del mismo tamaño. Hasta el 30 de noviembre.</li>
        <li data-when="home">Envío gratis en pedidos a partir de 60&nbsp;€.</li>
        <li>Fabricante: Gustav Baehr GmbH, Waiblingen (Alemania).</li>
        <li>Vendido por BAEHR España, distribuidor oficial de la marca.</li>
      </ul>
    </div>
  </section>

  <div class="buybar" aria-hidden="true">
    <span class="buybar__name">Crema en espuma <span class="buybar__size" data-buybar-size>125&nbsp;ml</span></span>
    <button class="pill pill--red" type="button" tabindex="-1" data-buybar>Añadir a la cesta</button>
  </div>

  <section class="band" aria-label="Datos del producto">
    <dl class="band__row">
      <div class="band__item rv"><dt>5&nbsp;%</dt><dd>de urea</dd></div>
      <div class="band__item rv"><dt>5 estrellas</dt><dd>en tolerancia cutánea, según Dermatest (09/2025)</dd></div>
      <div class="band__item rv"><dt>Vegana</dt><dd>sin ingredientes de origen animal</dd></div>
      <div class="band__item rv"><dt>2 tamaños</dt><dd>125 y 300&nbsp;ml</dd></div>
    </dl>
  </section>

  <section class="inside">
    <h2 class="h2 rv">Activos&nbsp;clave</h2>
    <ul class="inside__list">
      <li class="stretch"><span class="inside__n" aria-hidden="true">Urea</span> <span class="inside__q" aria-hidden="true">al 5&nbsp;%</span> <span class="sr">Urea al 5&nbsp;%</span></li>
      <li class="stretch"><span class="inside__n">Pantenol</span></li>
      <li class="stretch"><span class="inside__n" aria-hidden="true">Ginkgo</span> <span class="inside__q" aria-hidden="true">extracto</span> <span class="sr">Extracto de ginkgo</span></li>
      <li class="stretch"><span class="inside__n" aria-hidden="true">Ginseng</span> <span class="inside__q" aria-hidden="true">extracto</span> <span class="sr">Extracto de ginseng</span></li>
      <li class="stretch"><span class="inside__n" aria-hidden="true">Limón</span> <span class="inside__q" aria-hidden="true">extracto</span> <span class="sr">Extracto de limón</span></li>
    </ul>
  </section>

  <section class="texture">
    <h2 class="h2 rv">Textura&nbsp;ligera</h2>
    <div class="texture__body">
      <p class="texture__quote rv">Una espuma de rápida absorción que deja un tacto aterciopelado.</p>
      <p class="texture__note rv">Según BAEHR, las espumas para pies se absorben más rápido que las pomadas y apenas dejan residuos.</p>
    </div>
  </section>

  <section class="proto">
    <div class="proto__text">
      <h2 class="h2 rv">El último&nbsp;paso</h2>
      <p class="lead rv">Esta espuma cierra el protocolo de cinco pasos que te proponemos en la página de inicio.</p>
      <a class="pill pill--white rv" href="/#protocolo">Ver el protocolo</a>
    </div>
    <ol class="proto__steps rv" aria-label="Pasos del protocolo">
      {steps.map((s, i) => <li aria-current={i === 4 ? 'step' : undefined}>{s}</li>)}
    </ol>
  </section>

  <section class="shop shop--pairs">
    <div class="shop__head">
      <h2 class="h2 rv">Los otros cuatro&nbsp;pasos</h2>
    </div>
    <ul class="shop__row shop__row--four">
      {
        pairs.map((p) => (
          <li class="card rv">
            <a class="card__link" href={`/#paso-${p.step + 1}`} aria-label={p.aria}>
              <span class="card__img card__img--studio">
                <img src={`/img/estudio/${p.img}.webp`} width="800" height="1200" alt="" loading="lazy" decoding="async" />
              </span>
              <span class="card__name" lang="de">{p.name}</span>
              <span class="card__type">{p.type}</span>
              <span class="card__type">{p.size}</span>
              <span class="card__go">Ver en el protocolo</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="faq">
    <h2 class="h2 rv">Preguntas frecuentes</h2>
    <div class="faq__list">
      {
        faq.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<script>
  // Galería: tres imágenes del producto, sin 3D en la ficha (decisión del 22-11)
  const gal = document.querySelector('[data-galeria]');
  if (gal) {
    const imgs = gal.querySelectorAll('.pdp__img');
    const tabs = gal.querySelectorAll('.pdp__thumbs button');
    tabs.forEach((b, i) =>
      b.addEventListener('click', () => {
        imgs.forEach((im, k) => im.classList.toggle('is-on', k === i));
        tabs.forEach((t, k) => t.setAttribute('aria-pressed', String(k === i)));
      })
    );
  }
  // Cantidad y cesta: demostración, no envía nada
  const form = document.querySelector('.addcart');
  const out = form?.querySelector('output');
  let n = 1;
  form?.querySelectorAll('[data-qty]').forEach((b) =>
    b.addEventListener('click', () => {
      n = Math.max(1, Math.min(99, n + Number(b.dataset.qty)));
      if (out) out.textContent = String(n);
    })
  );
  // Barra de compra en el móvil: visible mientras el botón principal no está en pantalla; se retira al llegar al pie
  const bar = document.querySelector('.buybar');
  const mainBtn = form?.querySelector('.addcart__btn');
  const foot = document.querySelector('.foot');
  if (bar && mainBtn && 'IntersectionObserver' in window) {
    let btnSeen = false;
    let footSeen = false;
    const sync = () => bar.classList.toggle('is-on', !btnSeen && !footSeen);
    new IntersectionObserver((e) => {
      btnSeen = e[0].isIntersecting;
      sync();
    }).observe(mainBtn);
    if (foot)
      new IntersectionObserver((e) => {
        footSeen = e[0].isIntersecting;
        sync();
      }).observe(foot);
    bar.querySelector('[data-buybar]')?.addEventListener('click', () => form?.requestSubmit());
    const size = bar.querySelector('[data-buybar-size]');
    document.querySelectorAll<HTMLInputElement>('.sizes input').forEach((r) =>
      r.addEventListener('change', () => {
        if (size && r.checked) size.textContent = `${r.value}\u00a0ml`;
      })
    );
  }
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const ok = form.querySelector('.addcart__ok');
    if (ok) ok.hidden = false;
    (window as any).baehrCesta?.add('espuma', n);
  });
</script>
