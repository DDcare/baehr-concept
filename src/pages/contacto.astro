---
// Contacto: canales que ya existen en el pie, dirección y un formulario de demostración.
import Base from '../layouts/Base.astro';

const title = 'Contacto y dirección en Barcelona | BAEHR España';
const description =
  'Contacta con BAEHR España por WhatsApp, Telegram, Instagram, Facebook o el formulario. Calle Perelló, 34, 08005 Barcelona.';

const canales = [
  { n: 'WhatsApp', t: 'Para tus consultas por mensaje.', href: 'https://wa.me/34616458742' },
  { n: 'Telegram', t: 'Para escribirnos si usas Telegram.', href: 'https://t.me/baehr_spain' },
  { n: 'Instagram', t: 'Para seguir nuestras novedades.', href: 'https://www.instagram.com/baehr.espana/' },
  { n: 'Facebook', t: 'Para estar al día.', href: 'https://www.facebook.com/baehr.espana' },
];
---

<Base title={title} description={description} page="contacto">
  <section class="contact-hero">
    <h1 class="contact-hero__h"><span class="stretch is-in">Escríbenos</span></h1>
    <p class="lead">¿Una duda sobre un producto, un pedido o tu alta profesional? Usa el canal que prefieras. Atendemos a profesionales y particulares.</p>
  </section>

  <section class="contact">
    <ul class="channels">
      {
        canales.map((c) => (
          <li>
            <a class="channel" href={c.href} rel="noopener">
              <span class="channel__n stretch">{c.n}</span>
              <span class="channel__t">{c.t}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="contact__side">
      <div class="addr">
        <h2 class="addr__h">Dirección</h2>
        <p>BAEHR España<br />Proxy Beauty Spain, S.L.<br />Calle Perelló, 34<br />08005 Barcelona</p>
      </div>

      <form class="cform" novalidate>
        <label><span>Nombre</span><input type="text" name="nombre" autocomplete="name" required /></label>
        <label><span>Correo electrónico</span><input type="email" name="correo" autocomplete="email" required /></label>
        <fieldset class="sizes cform__who">
          <legend>Soy</legend>
          <label><input type="radio" name="soy" value="pro" checked /><span>Profesional</span></label>
          <label><input type="radio" name="soy" value="home" /><span>Particular</span></label>
        </fieldset>
        <label><span>Mensaje</span><textarea name="mensaje" rows="4" required></textarea></label>
        <label class="consent"><input type="checkbox" name="privacidad" required /><span>He leído y acepto la <a href="/">política de privacidad</a>.</span></label>
        <button class="pill pill--red" type="submit">Enviar mensaje</button>
        <p class="cform__ok" role="status" hidden>Mensaje enviado. Gracias por escribirnos.</p>
        <p class="signup__note">Demostración de diseño: no se envía ningún dato.</p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.cform');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea').forEach((el) => {
      const v = el.checkValidity();
      el.setAttribute('aria-invalid', String(!v));
      if (!v && ok) {
        el.focus();
        ok = false;
      }
    });
    const msg = form.querySelector<HTMLElement>('.cform__ok');
    if (msg) msg.hidden = !ok;
  });
</script>
