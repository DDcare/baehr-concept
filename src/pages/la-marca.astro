---
// Página "La marca". Tekst: redactor-es (21-11). Feiten alleen uit docs/merk-en-woordenlijst.md, deel A.
import Base from '../layouts/Base.astro';
import { MARCAS } from '../data/marcas';

const title = 'BAEHR, empresa familiar alemana desde 1949 | BAEHR España';
const description =
  'BAEHR, empresa familiar alemana fundada en 1949 en Waiblingen: su historia, sus seis marcas y su distribución oficial en España.';

const worlds = MARCAS;
// La historia en cuatro fechas: las mismas frases de siempre, partidas por año
const era = [
  { y: '1949', t: 'Gustav Baehr, comerciante de Hamburgo, fundó en 1949 en Waiblingen la empresa Technik Baehr. Sus primeros clientes fueron orfebres y dentistas; los profesionales de la pedicura y la estética llegaron después.' },
  { y: '1969', t: 'La empresa se convirtió en sociedad limitada con el nombre de Gustav Baehr GmbH.' },
  { y: '1977', t: 'En 1977 tomaron el relevo dos hijos del fundador.' },
  { y: 'Hoy', t: 'Hoy la empresa cuenta con una plantilla de casi 135 personas y tiene su sede, con sala de exposición, en Waiblingen.' }
];
const pasos = ['bano', 'exfoliante', 'mascarilla', 'crema', 'espuma'];
---

<Base title={title} description={description} page="marca">
  <section class="about-hero">
    <h1 class="about-hero__h">
      <span class="stretch is-in">BAEHR,</span>
      <span class="stretch is-in">de&nbsp;cerca</span>
    </h1>
    <p class="lead">
      BAEHR nació en 1949 en Waiblingen (Alemania) y sigue siendo una empresa familiar. Fabrica y distribuye productos de
      podología, cuidado de los pies, cosmética y diseño de uñas. BAEHR España es distribuidor oficial de la marca.
    </p>
  </section>

  <div class="about-film">
    <img class="rv" src="/img/estudio/baehr.webp" width="1800" height="760" alt="" fetchpriority="high" />
  </div>

  <section class="era" aria-labelledby="era-h">
    <h2 class="h2 rv" id="era-h">De 1949 a&nbsp;hoy</h2>
    <ol class="era__row">
      {
        era.map((e) => (
          <li class="era__item rv">
            <span class="era__y stretch">{e.y}</span>
            <p>{e.t}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="band band--pad" aria-label="BAEHR en cifras">
    <dl class="band__row">
      <div class="band__item rv"><dt>1949</dt><dd>fundación en Waiblingen</dd></div>
      <div class="band__item rv"><dt>1977</dt><dd>relevo generacional</dd></div>
      <div class="band__item rv"><dt>Casi 135</dt><dd>personas en plantilla</dd></div>
      <div class="band__item rv"><dt>+40</dt><dd>países con distribuidor oficial</dd></div>
    </dl>
  </section>

  <section class="casas" aria-labelledby="casas-h">
    <div class="casas__head">
      <h2 class="h2 rv" id="casas-h">Seis marcas de la&nbsp;casa</h2>
      <p class="lead rv">Todo lo que BAEHR firma con su nombre se reparte en seis marcas.</p>
    </div>
    <ul class="casas__grid">
      {
        worlds.map((w) => (
          <li class="casa rv">
            <span class="casa__n">{w.n}</span>
            <span class="casa__t">{w.t}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="gremio">
    <ul class="gremio__row" aria-hidden="true">
      {pasos.map((p) => <li><img src={`/img/estudio/${p}.webp`} width="800" height="1200" alt="" loading="lazy" decoding="async" /></li>)}
    </ul>
    <div class="statement">
      <h2 class="statement__es rv">Del gremio, para el&nbsp;gremio</h2>
      <p class="statement__p rv">
        PEDIBAEHR es la marca de BAEHR para el cuidado de los pies, con productos creados por y para especialistas. Detrás de su
        desarrollo hay más de setenta años de experiencia e investigación, y sus fórmulas combinan principios activos modernos y
        clásicos. La gama cubre todas las necesidades del cuidado de los pies y se ordena por tipo de piel, del 1 al 7.
      </p>
      <p class="statement__de rv" lang="de">„Produkte für und von Fußpflegespezialisten“, PEDIBAEHR</p>
    </div>
  </section>

  <section class="duo">
    <div class="duo__col duo__col--line rv">
      <h2 class="h2">El saber se&nbsp;comparte</h2>
      <p class="lead">BAEHR comparte lo que sabe con los profesionales en sus seminarios.</p>
      <a class="pill pill--line" href="/#seminarios">Ver los seminarios</a>
    </div>
    <div class="duo__col duo__col--ink rv">
      <h2 class="h2">BAEHR en&nbsp;España</h2>
      <p class="lead">
        BAEHR España es Proxy Beauty Spain, S.L., distribuidor oficial de la marca, con sede en Barcelona. Figura como tal en
        la lista de distribuidores internacionales que publica BAEHR. Atendemos a salones, profesionales de manicura y pedicura,
        podólogos y particulares.
      </p>
      <p class="duo__addr">Proxy Beauty Spain, S.L.<br />Calle Perelló, 34<br />08005 Barcelona</p>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta__h">¿Empezamos?</h2>
    <p class="cta__t">Date de alta como profesional o recorre el protocolo, producto a producto.</p>
    <div class="cta__b">
      <a class="pill pill--white" href="/profesionales/#alta">Darme de alta</a>
      <a class="pill pill--line-white" href="/#protocolo">Ver el protocolo</a>
    </div>
  </section>
</Base>
